{
  // The agent host runs on Bun and is only type-checked here: `bun build --compile` makes the
  // binary. Every check TypeScript has is on, including the libraries' own types
  // (`skipLibCheck` stays off, or an unresolved type there would quietly become `any`); a
  // rule is never relaxed to quiet an error. Unused names, fallthrough and unreachable code
  // are ESLint's to report (eslint.config.ts), so each has one source.
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "Preserve",
    "types": ["bun"],
    "noEmit": true,
    // Checking the libraries is most of the time a check takes; a run keeps what it learned
    // for the next, which then checks only what changed.
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,

    // Types and values never share an import, and nothing TypeScript would have to compile
    // to JavaScript of its own (enums, namespaces, parameter properties) is written.
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src", "test", "scripts", "eslint.config.ts"]
}
