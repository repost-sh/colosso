+bool ChromeBrowserHostImpl::IsCloseHandledByClient(bool proceed) {
+  CEF_REQUIRE_UIT();
+  if (!std::exchange(is_trying_to_close_, false) || !proceed) {
+    return false;
+  }
+  if (auto client = GetClient()) {
+    if (auto handler = client->GetLifeSpanHandler()) {
+      return handler->DoClose(this);
+    }
+  }
+  return false;
 }
 
