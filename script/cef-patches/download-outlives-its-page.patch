+// Koyo: The browser that asked for a download, for after it's destroyed, as
+// Chrome's downloads outlive their tab: the handler it had, which is told of the
+// download, and what keeps the profile loaded until the download has ended, as
+// Chrome does (ProfileKeepAliveOrigin::kDownloadInProgress).
+class CefDownloadRequester : public download::DownloadRequester,
+                             public CefContext::Observer {
+ public:
+  CefDownloadRequester(CefRefPtr<CefBrowserHostBase> browser,
+                       content::BrowserContext* browser_context)
+      : handler_(GetDownloadHandler(browser)),
+        alloy_style_(browser->IsAlloyStyle()) {
+    CefContext::Get()->AddObserver(this);
+    Keep(browser_context);
+  }
+
+  static CefDownloadRequester* Get(DownloadItem* item) {
+    return static_cast<CefDownloadRequester*>(DownloadRequester::Get(*item));
+  }
+
+  CefRefPtr<CefDownloadHandler> handler() const { return handler_; }
+  bool alloy_style() const { return alloy_style_; }
+
+  // |item|, which was asked for, is updated.
+  void OnUpdated(DownloadItem* item) {
+    if (item->GetState() == DownloadItem::IN_PROGRESS) {
+      Keep(content::DownloadItemUtils::GetBrowserContext(item));
+    } else if (request_context_) {
+      // This may be the last reference to what keeps the profile, and |item|
+      // with it, so the current call stack unwinds first.
+      CEF_POST_TASK(CEF_UIT, base::DoNothingWithBoundArgs(
+                                 std::exchange(request_context_, nullptr)));
+    }
+  }
+
+  // CefContext::Observer methods.
+  void OnContextDestroyed() override {
+    CefContext::Get()->RemoveObserver(this);
+    context_destroyed_ = true;
+    request_context_ = nullptr;
+  }
+
+ private:
+  ~CefDownloadRequester() override {
+    if (!context_destroyed_) {
+      CefContext::Get()->RemoveObserver(this);
+    }
+  }
+
+  void Keep(content::BrowserContext* browser_context) {
+    if (request_context_ || context_destroyed_) {
+      return;
+    }
+    if (auto* context = CefBrowserContext::FromBrowserContext(browser_context)) {
+      request_context_ =
+          CefRequestContextImpl::GetOrCreateForBrowserContext(context, nullptr);
+    }
+  }
+
+  const CefRefPtr<CefDownloadHandler> handler_;
+  const bool alloy_style_;
+  CefRefPtr<CefRequestContextImpl> request_context_;
+  bool context_destroyed_ = false;
+};
