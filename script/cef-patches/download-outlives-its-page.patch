@@ -0,0 +1,41 @@
+// Koyo: Who asked for a download.
+
+#ifndef COMPONENTS_DOWNLOAD_PUBLIC_COMMON_DOWNLOAD_REQUESTER_H_
+#define COMPONENTS_DOWNLOAD_PUBLIC_COMMON_DOWNLOAD_REQUESTER_H_
+
+#include "base/memory/ref_counted_delete_on_sequence.h"
+#include "base/supports_user_data.h"
+#include "components/download/public/common/download_export.h"
+
+namespace base {
+template <class T>
+class DeleteHelper;
+}
+
+namespace download {
+
+// Who asked for a download, as the embedder knows them: made on the UI thread
+// as the download is asked for, carried to the DownloadItem it becomes, and
+// deleted on the UI thread with the item, or with the request if it becomes
+// none. The page that asked may be gone by then.
+class COMPONENTS_DOWNLOAD_EXPORT DownloadRequester
+    : public base::RefCountedDeleteOnSequence<DownloadRequester> {
+ public:
+  DownloadRequester();
+
+  DownloadRequester(const DownloadRequester&) = delete;
+  DownloadRequester& operator=(const DownloadRequester&) = delete;
+
+  // The requester attached to |item|, or nullptr.
+  static DownloadRequester* Get(const base::SupportsUserData& item);
+  void AttachTo(base::SupportsUserData& item);
+
+ protected:
+  friend class base::RefCountedDeleteOnSequence<DownloadRequester>;
+  friend class base::DeleteHelper<DownloadRequester>;
+  virtual ~DownloadRequester();
+};
+
+}  // namespace download
+
+#endif  // COMPONENTS_DOWNLOAD_PUBLIC_COMMON_DOWNLOAD_REQUESTER_H_
