+// Koyo: Who asked for a download.
+
+#include "components/download/public/common/download_requester.h"
+
+#include <memory>
+
+#include "base/task/sequenced_task_runner.h"
+
+namespace download {
+
+namespace {
+
+const char kKey[] = "DownloadRequester";
+
+}  // namespace
+
+DownloadRequester::DownloadRequester()
+    : base::RefCountedDeleteOnSequence<DownloadRequester>(
+          base::SequencedTaskRunner::GetCurrentDefault()) {}
+
+DownloadRequester::~DownloadRequester() = default;
+
+// static
+DownloadRequester* DownloadRequester::Get(const base::SupportsUserData& item) {
+  return base::UserDataAdapter<DownloadRequester>::Get(&item, &kKey);
+}
+
+void DownloadRequester::AttachTo(base::SupportsUserData& item) {
+  item.SetUserData(
+      &kKey, std::make_unique<base::UserDataAdapter<DownloadRequester>>(this));
+}
+
+}  // namespace download
