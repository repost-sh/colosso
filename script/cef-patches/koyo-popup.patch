+#if BUILDFLAG(IS_MAC)
+void ExtensionPopup::OnPaintAsActiveChanged() {
+  // Koyo: a popup over an embedder's page closes when the keyboard leaves its
+  // widget tree for a window that isn't Chromium's: the embedder's window, the
+  // page's, or another app's. Chrome closes a popup when its browser's window
+  // becomes active again (OnWidgetTreeActivated()), and the window an
+  // embedder's page is in is never one of Chromium's. AppKit says which window
+  // has the keyboard only after the one that lost it has heard so
+  // (AppController's -windowDidResignKey:), so it is asked once the change is
+  // over.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&ExtensionPopup::FollowKeyboard,
+                                deferred_close_weak_ptr_factory_.GetWeakPtr()));
+}
+
+void ExtensionPopup::FollowKeyboard() {
+  views::Widget* const keyboard =
+      views::Widget::GetWidgetForNativeWindow(platform_util::GetActiveWindow());
+  // The popup has it, or a widget of its own does: a list or a bubble it
+  // opened.
+  for (views::Widget* widget = keyboard; widget; widget = widget->parent()) {
+    if (widget == GetWidget()) {
+      had_keyboard_ = true;
+      return;
+    }
+  }
+  // A window of Chromium's has it: one of its page's, whose activation closes
+  // the popup already, or another of Chrome's, which leaves it open, as in
+  // Chrome. Or the popup never had it to lose.
+  if (keyboard || !had_keyboard_) {
+    return;
+  }
+  CloseUnlessBlockedByInspectionOrJSDialog();
+}
+#endif
