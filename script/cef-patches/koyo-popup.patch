+void ExtensionActionDelegateDesktop::OnEmbedderButtonPointerDown() {
+  // Koyo: as the pointer going down on the toolbar's own button does
+  // (ToolbarActionView::OnMousePressed), it closes the action's open popup,
+  // and the press it starts opens none.
+  const bool showing = IsShowingPopup();
+  embedder_button_reopen_suppressor_.OnMousePressed(
+      /*extra_suppress_condition=*/showing);
+  if (showing) {
+    HidePopup();
+  }
+}
+
+void ExtensionActionDelegateDesktop::PressEmbedderButton(
+    const EmbedderActionButton& button) {
+  if (embedder_button_reopen_suppressor_.ShouldSuppressBubbleShow(
+          /*is_pointer_interaction=*/true)) {
+    return;
+  }
+  // A press that came with no pointer going down before it, as from the
+  // keyboard, closes the open popup too.
+  if (IsShowingPopup()) {
+    HidePopup();
+    return;
+  }
+  base::AutoReset<std::optional<EmbedderActionButton>> pressed(
+      &pressed_embedder_button_, button);
+  model_->ExecuteUserAction(
+      ToolbarActionViewModel::InvocationSource::kToolbarButton);
+}
