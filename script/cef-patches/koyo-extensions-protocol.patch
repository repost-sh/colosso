+protocol::DispatchResponse ExtensionsHandler::KoyoGetInstalled(
+    std::unique_ptr<protocol::Array<protocol::Extensions::KoyoExtension>>*
+        out_extensions) {
+  if (!allow_loading_extensions_) {
+    return protocol::Response::ServerError("Method not available.");
+  }
+  ProfileManager* profile_manager = g_browser_process->profile_manager();
+  if (!profile_manager) {
+    return protocol::Response::ServerError("No profile manager.");
+  }
+  auto result =
+      std::make_unique<protocol::Array<protocol::Extensions::KoyoExtension>>();
+  for (Profile* profile : profile_manager->GetLoadedProfiles()) {
+    extensions::ExtensionRegistry* registry =
+        extensions::ExtensionRegistry::Get(profile);
+    if (!registry || profile->IsOffTheRecord()) {
+      continue;
+    }
+    ToolbarActionsModel* toolbar = ToolbarActionsModel::Get(profile);
+    const std::string profile_name = profile->GetBaseName().AsUTF8Unsafe();
+    const extensions::ExtensionSet installed =
+        registry->GenerateInstalledExtensionsSet();
+    for (const auto& extension : installed) {
+      if (!extensions::ui_util::ShouldDisplayInExtensionSettings(*extension)) {
+        continue;
+      }
+      const extensions::ActionInfo* info =
+          extensions::ActionInfo::GetExtensionActionInfo(extension.get());
+      result->emplace_back(
+          protocol::Extensions::KoyoExtension::Create()
+              .SetId(extension->id())
+              .SetProfile(profile_name)
+              .SetName(extension->name())
+              .SetVersion(extension->VersionString())
+              .SetDescription(
+                  extensions::DescriptionInfo::GetDescription(*extension))
+              .SetEnabled(
+                  registry->enabled_extensions().Contains(extension->id()))
+              .SetRemovable(KoyoRemovable(profile, *extension))
+              .SetHasAction(info != nullptr)
+              .SetHasPopup(info && !info->default_popup_url.is_empty())
+              .SetPinned(toolbar && toolbar->IsActionPinned(extension->id()))
+              .SetOptionsUrl(
+                  extensions::OptionsPageInfo::HasOptionsPage(extension.get())
+                      ? extensions::OptionsPageInfo::GetOptionsPage(
+                            extension.get())
+                            .spec()
+                      : std::string())
+              .SetHomepageUrl(
+                  extensions::ManifestURL::GetHomepageURL(extension.get())
+                      .spec())
+              .SetIconPath(KoyoIconPath(*extension))
+              .SetLocation(KoyoLocation(*extension))
+              .Build());
+    }
+  }
+  *out_extensions = std::move(result);
+  return protocol::Response::Success();
+}
