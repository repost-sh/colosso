+// Koyo: forwards one profile's changes to the handler: its extensions'
+// actions, which extensions it has, and which are pinned.
+class ExtensionsHandler::ProfileWatch
+    : public extensions::ExtensionActionDispatcher::Observer,
+      public extensions::ExtensionRegistryObserver,
+      public ToolbarActionsModel::Observer {
+ public:
+  ProfileWatch(ExtensionsHandler* handler, Profile* profile)
+      : handler_(handler), profile_(profile->GetBaseName().AsUTF8Unsafe()) {
+    if (auto* dispatcher = extensions::ExtensionActionDispatcher::Get(profile)) {
+      actions_.Observe(dispatcher);
+    }
+    if (auto* registry = extensions::ExtensionRegistry::Get(profile)) {
+      registry_.Observe(registry);
+    }
+    if (auto* toolbar = ToolbarActionsModel::Get(profile)) {
+      toolbar_.Observe(toolbar);
+    }
+  }
+
+  const std::string& profile() const { return profile_; }
+
+  // extensions::ExtensionActionDispatcher::Observer:
+  void OnExtensionActionUpdated(
+      extensions::ExtensionAction* extension_action,
+      content::WebContents* web_contents,
+      content::BrowserContext* browser_context) override {
+    handler_->ReportAction(*extension_action, web_contents, browser_context);
+  }
+  void OnShuttingDown() override { actions_.Reset(); }
+
+  // extensions::ExtensionRegistryObserver:
+  void OnExtensionLoaded(content::BrowserContext* browser_context,
+                         const extensions::Extension* extension) override {
+    handler_->ReportInstalledChanged(profile_);
+  }
+  void OnExtensionUnloaded(content::BrowserContext* browser_context,
+                           const extensions::Extension* extension,
+                           extensions::UnloadedExtensionReason reason) override {
+    handler_->ReportInstalledChanged(profile_);
+  }
+  void OnExtensionInstalled(content::BrowserContext* browser_context,
+                            const extensions::Extension* extension,
+                            bool is_update) override {
+    handler_->ReportInstalledChanged(profile_);
+  }
+  void OnExtensionUninstalled(content::BrowserContext* browser_context,
+                              const extensions::Extension* extension,
+                              extensions::UninstallReason reason) override {
+    handler_->ReportInstalledChanged(profile_);
+  }
+  void OnShutdown(extensions::ExtensionRegistry* registry) override {
+    registry_.Reset();
+  }
+
+  // ToolbarActionsModel::Observer:
+  void OnToolbarActionAdded(const ToolbarActionsModel::ActionId& id) override {}
+  void OnToolbarActionRemoved(
+      const ToolbarActionsModel::ActionId& id) override {}
+  void OnToolbarActionUpdated(
+      const ToolbarActionsModel::ActionId& id) override {}
+  void OnToolbarModelInitialized() override {}
+  void OnToolbarPinnedActionsChanged() override {
+    handler_->ReportInstalledChanged(profile_);
+  }
+  void OnToolbarActionsModelShutdown() override { toolbar_.Reset(); }
+
+ private:
+  raw_ptr<ExtensionsHandler> handler_;
+  const std::string profile_;
+  base::ScopedObservation<extensions::ExtensionActionDispatcher,
+                          extensions::ExtensionActionDispatcher::Observer>
+      actions_{this};
+  base::ScopedObservation<extensions::ExtensionRegistry,
+                          extensions::ExtensionRegistryObserver>
+      registry_{this};
+  base::ScopedObservation<ToolbarActionsModel, ToolbarActionsModel::Observer>
+      toolbar_{this};
+};
