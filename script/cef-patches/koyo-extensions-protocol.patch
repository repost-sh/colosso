+protocol::DispatchResponse ExtensionsHandler::KoyoSetActivePage(
+    int browser_id) {
+  if (!allow_loading_extensions_) {
+    return protocol::Response::ServerError("Method not available.");
+  }
+  content::WebContents* web_contents = KoyoPage(browser_id);
+  if (!web_contents) {
+    return protocol::Response::ServerError("No page for the provided id.");
+  }
+  BrowserWindowInterface* browser =
+      extensions::browser_window_util::GetBrowserForTabContents(*web_contents);
+  BrowserActiveStateManager* state =
+      browser ? BrowserActiveStateManager::From(browser) : nullptr;
+  if (!state) {
+    return protocol::Response::ServerError("The page is in no browser.");
+  }
+#if BUILDFLAG(ENABLE_CEF)
+  // The embedder's other pages stop being the active one: none of their
+  // windows is ever key, so nothing else tells them. A window of Chrome's own
+  // hears it from its widget and is left alone.
+  std::vector<BrowserWindowInterface*> others;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&](BrowserWindowInterface* other) {
+        if (other != browser && other->cef_delegate() &&
+            other->cef_delegate()->IsViewsHosted()) {
+          others.push_back(other);
+        }
+        return true;
+      });
+  for (BrowserWindowInterface* other : others) {
+    if (BrowserActiveStateManager* other_state =
+            BrowserActiveStateManager::From(other)) {
+      other_state->DidBecomeInactive();
+    }
+  }
+#endif
+  // Said again of a page that already counts as active, it is the last active
+  // one again: a window of Chrome's own may have been in between, which leaves
+  // the page active and no longer the last.
+  if (state->IsActive()) {
+    state->DidBecomeInactive();
+  }
+  state->DidBecomeActive();
+  return protocol::Response::Success();
