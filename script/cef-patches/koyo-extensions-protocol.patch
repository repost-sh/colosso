+// Koyo: the name of `context`'s profile directory, which is how the embedder
+// knows a profile.
+std::string KoyoProfileName(content::BrowserContext* context) {
+  return Profile::FromBrowserContext(context)
+      ->GetOriginalProfile()
+      ->GetBaseName()
+      .AsUTF8Unsafe();
+}
+
+// Koyo: the loaded profile whose directory is named `name`.
+Profile* KoyoProfileNamed(const std::string& name) {
+  ProfileManager* manager = g_browser_process->profile_manager();
+  if (!manager) {
+    return nullptr;
+  }
+  for (Profile* profile : manager->GetLoadedProfiles()) {
+    if (profile->GetBaseName().AsUTF8Unsafe() == name) {
+      return profile;
+    }
+  }
+  return nullptr;
+}
+
+// Koyo: the file of `extension`'s toolbar icon, the largest it comes in up to
+// 128 pixels: the action's default icon, else the extension's own.
+std::string KoyoIconPath(const extensions::Extension& extension) {
+  auto pick = [](const ExtensionIconSet& icons) {
+    std::string path = icons.Get(128, ExtensionIconSet::Match::kSmaller);
+    return path.empty() ? icons.Get(128, ExtensionIconSet::Match::kBigger)
+                        : path;
+  };
+  std::string relative;
+  if (const extensions::ActionInfo* info =
+          extensions::ActionInfo::GetExtensionActionInfo(&extension)) {
+    relative = pick(info->default_icon);
+  }
+  if (relative.empty()) {
+    relative = pick(extensions::IconsInfo::GetIcons(&extension));
+  }
+  if (relative.empty()) {
+    return std::string();
+  }
+  return extension.path()
+      .Append(base::FilePath::FromUTF8Unsafe(relative))
+      .AsUTF8Unsafe();
+}
+
+std::string KoyoLocation(const extensions::Extension& extension) {
+  using extensions::mojom::ManifestLocation;
+  switch (extension.location()) {
+    case ManifestLocation::kUnpacked:
+      return "unpacked";
+    case ManifestLocation::kCommandLine:
+      return "commandLine";
+    case ManifestLocation::kExternalPolicy:
+    case ManifestLocation::kExternalPolicyDownload:
+      return "policy";
+    default:
+      return extension.from_webstore() ? "store" : "other";
+  }
+}
