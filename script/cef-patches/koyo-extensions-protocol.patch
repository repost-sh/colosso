+// Observes `profile` and reports its actions' tab-independent state.
+void ExtensionsHandler::WatchProfile(Profile* profile) {
+  if (profile->IsOffTheRecord()) {
+    return;
+  }
+  const std::string name = profile->GetBaseName().AsUTF8Unsafe();
+  for (const auto& watch : profile_watches_) {
+    if (watch->profile() == name) {
+      return;
+    }
+  }
+  profile_watches_.push_back(std::make_unique<ProfileWatch>(this, profile));
+  extensions::ExtensionActionManager* manager =
+      extensions::ExtensionActionManager::Get(profile);
+  extensions::ExtensionRegistry* registry =
+      extensions::ExtensionRegistry::Get(profile);
+  if (!manager || !registry) {
+    return;
+  }
+  for (const auto& extension : registry->enabled_extensions()) {
+    if (extensions::ExtensionAction* action =
+            manager->GetExtensionAction(*extension)) {
+      ReportAction(*action, nullptr, profile);
+    }
+  }
+}
