+protocol::DispatchResponse ExtensionsHandler::KoyoSetEnabled(
+    const protocol::String& id,
+    const protocol::String& profile_name,
+    bool enabled) {
+  if (!allow_loading_extensions_) {
+    return protocol::Response::ServerError("Method not available.");
+  }
+  Profile* profile = KoyoProfileNamed(profile_name);
+  if (!profile) {
+    return protocol::Response::ServerError("No such profile.");
+  }
+  const extensions::Extension* extension =
+      extensions::ExtensionRegistry::Get(profile)->GetInstalledExtension(id);
+  if (!extension) {
+    return protocol::Response::ServerError("No such extension.");
+  }
+  if (!KoyoRemovable(profile, *extension)) {
+    return protocol::Response::ServerError("A policy keeps it as it is.");
+  }
+  extensions::ExtensionRegistrar* registrar =
+      extensions::ExtensionRegistrar::Get(profile);
+  if (enabled) {
+    registrar->EnableExtension(id);
+  } else {
+    registrar->DisableExtension(
+        id, {extensions::disable_reason::DISABLE_USER_ACTION});
+  }
+  return protocol::Response::Success();
+}
 
+protocol::DispatchResponse ExtensionsHandler::KoyoUninstall(
+    const protocol::String& id,
+    const protocol::String& profile_name) {
+  if (!allow_loading_extensions_) {
+    return protocol::Response::ServerError("Method not available.");
+  }
+  Profile* profile = KoyoProfileNamed(profile_name);
+  if (!profile) {
+    return protocol::Response::ServerError("No such profile.");
+  }
+  const extensions::Extension* extension =
+      extensions::ExtensionRegistry::Get(profile)->GetInstalledExtension(id);
+  if (!extension) {
+    return protocol::Response::ServerError("No such extension.");
+  }
+  if (!KoyoRemovable(profile, *extension)) {
+    return protocol::Response::ServerError("A policy keeps it installed.");
+  }
+  std::u16string error;
+  if (!extensions::ExtensionRegistrar::Get(profile)->UninstallExtension(
+          id, extensions::UNINSTALL_REASON_USER_INITIATED, &error)) {
+    return protocol::Response::ServerError(base::UTF16ToUTF8(error));
+  }
+  return protocol::Response::Success();
+}
+
+protocol::DispatchResponse ExtensionsHandler::KoyoSetPinned(
+    const protocol::String& id,
+    const protocol::String& profile_name,
+    bool pinned) {
+  if (!allow_loading_extensions_) {
+    return protocol::Response::ServerError("Method not available.");
+  }
+  Profile* profile = KoyoProfileNamed(profile_name);
+  ToolbarActionsModel* toolbar =
+      profile ? ToolbarActionsModel::Get(profile) : nullptr;
+  if (!toolbar) {
+    return protocol::Response::ServerError("No such profile.");
+  }
+  if (!toolbar->HasAction(id)) {
+    return protocol::Response::ServerError("No such extension.");
+  }
+  if (toolbar->IsActionForcePinned(id)) {
+    return protocol::Response::ServerError("A policy keeps it pinned.");
+  }
+  if (toolbar->IsActionPinned(id) != pinned) {
+    toolbar->SetActionVisibility(id, pinned);
+  }
+  return protocol::Response::Success();
+}
