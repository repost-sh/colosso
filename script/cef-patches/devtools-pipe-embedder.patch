 void RemoteDebuggingServer::StartPipeHandler() {
+#if !BUILDFLAG(IS_WIN)
+  // Koyo: an embedder that holds the pipe's other ends itself
+  // (--remote-debugging-io-pipes) stops the browser when it means to. Its end
+  // closing, as it does when the embedder's process goes, is no request to
+  // quit: the exit that would start here runs beside the embedder's own
+  // shutdown and ends the process before the profiles have written theirs.
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "remote-debugging-io-pipes")) {
+    content::DevToolsAgentHost::StartRemoteDebuggingPipeHandler(
+        base::DoNothing());
+    return;
+  }
+#endif
   content::DevToolsAgentHost::StartRemoteDebuggingPipeHandler(
       base::BindOnce(&ChromeDevToolsManagerDelegate::CloseBrowserSoon));
 }
