+// Koyo: whether an embedder holds the pipe's other ends itself
+// (--remote-debugging-io-pipes, which names descriptors of this process). It
+// asks for the pipe with that switch alone: --remote-debugging-pipe is passed
+// on to every renderer, which takes it for a browser under automation
+// (navigator.webdriver), and the embedder's pipe drives no page.
+bool EmbedderHoldsPipe() {
+#if BUILDFLAG(IS_WIN)
+  return false;
+#else
+  return base::CommandLine::ForCurrentProcess()->HasSwitch(
+      "remote-debugging-io-pipes");
+#endif
+}
