+// Koyo: the extensions container of a page whose extensions' buttons an
+// embedder draws.
+
+#include "chrome/browser/ui/views/extensions/embedder_extensions_container.h"
+
+#include <utility>
+
+#include "base/check.h"
+#include "base/location.h"
+#include "base/task/sequenced_task_runner.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/extensions/extension_action_view_model.h"
+#include "chrome/browser/ui/toolbar/toolbar_action_view_model.h"
+#include "chrome/browser/ui/views/extensions/extension_action_delegate_desktop.h"
+#include "ui/base/base_window.h"
+#include "ui/views/bubble/bubble_dialog_delegate_view.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/widget/widget_delegate.h"
+
+EmbedderExtensionsContainer::EmbedderExtensionsContainer(
+    BrowserWindowInterface* browser,
+    views::View* page_top)
+    : browser_(browser),
+      page_top_(page_top),
+      toolbar_model_(ToolbarActionsModel::Get(browser->GetProfile())),
+      scoped_user_data_(browser->GetUnownedUserDataHost(), *this) {
+  page_top_observation_.Observe(page_top_);
+  toolbar_model_observation_.Observe(toolbar_model_);
+  if (toolbar_model_->actions_initialized()) {
+    OnToolbarModelInitialized();
+  }
+}
+
+EmbedderExtensionsContainer::~EmbedderExtensionsContainer() {
+  RemoveActions();
+}
+
+ToolbarActionViewModel* EmbedderExtensionsContainer::GetActionForId(
+    const std::string& action_id) {
+  auto it = actions_.find(action_id);
+  return it != actions_.end() ? it->second.get() : nullptr;
+}
+
+void EmbedderExtensionsContainer::HideActivePopup() {
+  if (popup_owner_) {
+    popup_owner_->HidePopup();
+  }
+}
+
+void EmbedderExtensionsContainer::CloseExtensionsMenuIfOpen() {
+  // The page's extensions menu is the embedder's: none of Chrome's opens over
+  // it.
+}
+
+bool EmbedderExtensionsContainer::ShowToolbarActionPopupForAPICall(
+    const std::string& action_id,
+    ShowPopupCallback callback) {
+  // As ExtensionsToolbarViewModel and ExtensionsToolbarDesktop have it: a
+  // popup an extension asks for shows in the active window only. Nothing here
+  // is ever popped out.
+  if (!browser_->GetWindow()->IsActive()) {
+    return false;
+  }
+  ToolbarActionViewModel* action = GetActionForId(action_id);
+  CHECK(action, base::NotFatalUntil::M162);
+  action->TriggerPopupForAPI(std::move(callback));
+  return true;
+}
+
+void EmbedderExtensionsContainer::ToggleExtensionsMenu() {
+  // The embedder draws the extensions menu.
+}
+
+bool EmbedderExtensionsContainer::HasAnyExtensions() const {
+  return !actions_.empty();
+}
+
+bool EmbedderExtensionsContainer::IsVisible() const {
+  // The embedder shows the extensions' buttons.
+  return true;
+}
+
+std::optional<extensions::ExtensionId>
+EmbedderExtensionsContainer::GetPoppedOutActionId() const {
+  return std::nullopt;
+}
+
+bool EmbedderExtensionsContainer::IsActionVisibleOnToolbar(
+    const std::string& action_id) const {
+  return toolbar_model_ && toolbar_model_->IsActionPinned(action_id);
+}
+
+void EmbedderExtensionsContainer::UndoPopOut() {
+  // Nothing pops out: the embedder's buttons are where it draws them.
+}
+
+void EmbedderExtensionsContainer::SetPopupOwner(
+    ToolbarActionViewModel* popup_owner) {
+  popup_owner_ = popup_owner;
+}
+
+void EmbedderExtensionsContainer::PopOutAction(
+    const extensions::ExtensionId& action_id,
+    base::OnceClosure closure) {
+  // Nothing pops out, and there is no animation to wait for: the closure runs
+  // next, as AnimatingLayoutManager::PostOrQueueAction() runs one when its
+  // layout isn't animating.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+                                                           std::move(closure));
+}
+
+void EmbedderExtensionsContainer::ShowWidgetForExtension(
+    views::Widget* widget,
+    const std::string& extension_id) {
+  // As ExtensionsToolbarDesktop::AnchorAndShowWidgetImmediately() hangs it
+  // from the extension's button: a widget made with an anchor of its own, as a
+  // device chooser is, may have none here, with no location bar drawn.
+  widget->widget_delegate()->AsBubbleDialogDelegate()->SetAnchorView(
+      page_top_);
+  widget->Show();
+}
+
+void EmbedderExtensionsContainer::CollapseConfirmation() {
+  // There is no request access button to collapse.
+}
+
+void EmbedderExtensionsContainer::ShowContextMenuAsFallback(
+    const extensions::ExtensionId& action_id) {
+  // The button and its menu are the embedder's.
+}
+
+void EmbedderExtensionsContainer::OnPopupShown(
+    const extensions::ExtensionId& action_id,
+    bool by_user) {
+  // The embedder's button has no pressed state of Chrome's to show.
+}
+
+void EmbedderExtensionsContainer::OnPopupClosed(
+    const extensions::ExtensionId& action_id) {}
+
+views::FocusManager*
+EmbedderExtensionsContainer::GetFocusManagerForAccelerator() {
+  return page_top_->GetFocusManager();
+}
+
+views::BubbleAnchor EmbedderExtensionsContainer::GetReferenceButtonForPopup(
+    const extensions::ExtensionId& action_id) {
+  return GetExtensionsButtonAnchor();
+}
+
+views::BubbleAnchor EmbedderExtensionsContainer::GetExtensionsButtonAnchor() {
+  return views::BubbleAnchor(page_top_.get());
+}
+
+views::BubbleBorder::Arrow EmbedderExtensionsContainer::GetPopupArrow() const {
+  return views::BubbleBorder::TOP_RIGHT;
+}
+
+void EmbedderExtensionsContainer::OnToolbarModelInitialized() {
+  for (const auto& action_id : toolbar_model_->action_ids()) {
+    AddAction(action_id);
+  }
+}
+
+void EmbedderExtensionsContainer::OnToolbarActionAdded(
+    const ToolbarActionsModel::ActionId& action_id) {
+  AddAction(action_id);
+}
+
+void EmbedderExtensionsContainer::OnToolbarActionRemoved(
+    const ToolbarActionsModel::ActionId& action_id) {
+  auto it = actions_.find(action_id);
+  if (it == actions_.end()) {
+    return;
+  }
+  it->second->HidePopup();
+  it->second->UnregisterCommand();
+  actions_.erase(it);
+}
+
+void EmbedderExtensionsContainer::OnToolbarActionUpdated(
+    const ToolbarActionsModel::ActionId& action_id) {
+  // The embedder hears of it over the protocol (koyoActionUpdated).
+}
+
+void EmbedderExtensionsContainer::OnToolbarPinnedActionsChanged() {
+  // The embedder hears of it over the protocol (koyoInstalledChanged).
+}
+
+void EmbedderExtensionsContainer::OnToolbarActionsModelShutdown() {
+  RemoveActions();
+  toolbar_model_observation_.Reset();
+  toolbar_model_ = nullptr;
+}
+
+void EmbedderExtensionsContainer::OnViewAddedToWidget(
+    views::View* observed_view) {
+  for (const auto& [_, action] : actions_) {
+    action->RegisterCommand();
+  }
+}
+
+void EmbedderExtensionsContainer::OnViewRemovedFromWidget(
+    views::View* observed_view) {
+  // As ToolbarActionView::RemovedFromWidget() does: while the widget's focus
+  // manager is still there. A page that closes leaves its widget before its
+  // toolbar, which holds this, is destroyed.
+  for (const auto& [_, action] : actions_) {
+    action->UnregisterCommand();
+  }
+}
+
+void EmbedderExtensionsContainer::AddAction(
+    const ToolbarActionsModel::ActionId& action_id) {
+  auto it = actions_
+                .emplace(action_id,
+                         ExtensionActionViewModel::Create(
+                             action_id, browser_,
+                             std::make_unique<ExtensionActionDelegateDesktop>(
+                                 browser_.get(), this, this)))
+                .first;
+  // As a toolbar button does once it is in its widget
+  // (ToolbarActionView::AddedToWidget()). Out of one, there is no focus manager
+  // to register with, and OnViewAddedToWidget() does it.
+  it->second->RegisterCommand();
+}
+
+void EmbedderExtensionsContainer::RemoveActions() {
+  HideActivePopup();
+  for (const auto& [_, action] : actions_) {
+    action->UnregisterCommand();
+  }
+  actions_.clear();
+}
