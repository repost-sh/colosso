+// Koyo: the extensions container of a page whose extensions' buttons an
+// embedder draws.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_EXTENSIONS_EMBEDDER_EXTENSIONS_CONTAINER_H_
+#define CHROME_BROWSER_UI_VIEWS_EXTENSIONS_EMBEDDER_EXTENSIONS_CONTAINER_H_
