#!/bin/sh
# The checks a change passes before it's committed: the lints in script/lint, then the tests.
set -eu
cd "$(dirname "$0")/.."

# The same cargo home as script/dev, so the two share what's built.
export CARGO_HOME="${CARGO_HOME:-$PWD/.cargo-home}"

script/lint
# Tests keep their settings in the checkout, away from the app's own.
COLOSSO_CONFIG_DIR="$PWD/target/test-config" cargo test --workspace
