#!/bin/sh
# The checks a change passes before it's committed: the lints in script/lint, then the tests.
set -eu
cd "$(dirname "$0")/.."

script/lint
# koyo-agent's tests run the compiled host, on its fake provider.
script/agent-host
# Tests keep their settings in the checkout, away from the app's own.
KOYO_CONFIG_DIR="$PWD/koyo-rs/target/test-config" script/cargo test --workspace
script/bun test
