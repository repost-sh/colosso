#!/bin/sh
# Builds Koyo.app, a release build to keep in Applications, at koyo-rs/target/bundle/Koyo.app:
#
#   script/bundle
#   ditto koyo-rs/target/bundle/Koyo.app /Applications/Koyo.app
#
# The app's executable, the agent host beside it, where a packaged app looks for it
# (koyo-rs/koyo/src/chat/host.rs), its icon, and in its Contents/Frameworks the browser engine
# (koyo-rs/koyo/src/browser/engine.rs) and the agent desktop's host
# (koyo-rs/koyo/src/agent_desktop/host.rs), signed for this Mac: enough to run here, not to
# hand out, which needs a release identity and notarization. The app is signed by the identity
# script/signing-identity makes, so macOS keeps what Koyo was allowed across builds, or ad hoc
# while there's none (docs/browser.md 12.7).
#
#   script/bundle --sign "Developer ID Application: <Org> (<TEAMID>)" [--profile <file>]
#
# signs it with a Developer ID identity instead, with the hardened runtime notarization needs.
# With --profile, a Developer ID provisioning profile for codes.koyo.desktop that carries Apple's
# browser-passkey entitlement, the app claims that entitlement and embeds the profile, so its
# pages can use passkeys (docs/browser.md 9). The profile is checked before anything is built.
# A build without --sign never claims an entitlement: macOS won't start an app that claims a
# managed one without its profile.
#
#   script/bundle --feed https://<host>/<path>/<target>/feed.json
#
# names the feed the app updates itself from, in its Info.plist as KoyoUpdateFeed, which the
# signature seals (docs/updates.md 2). A bundle without one never looks for an update: every
# build but a release's (script/release).
set -eu
cd "$(dirname "$0")/.."

export CARGO_HOME="${CARGO_HOME:-$PWD/.cargo-home}"

# The managed entitlement macOS asks of a browser before its passkey sheet takes requests for
# any site; the app checks for it at start (koyo-rs/koyo/src/browser/passkeys/mod.rs).
PASSKEYS=com.apple.developer.web-browser.public-key-credential
BUNDLE_ID=codes.koyo.desktop

identity=""
profile=""
feed=""
while [ $# -gt 0 ]; do
  case "$1" in
    --sign) identity="$2"; shift ;;
    --profile) profile="$2"; shift ;;
    --feed) feed="$2"; shift ;;
    *) echo "script/bundle: unknown option $1" >&2; exit 2 ;;
  esac
  shift
done
if [ -n "$profile" ] && [ -z "$identity" ]; then
  echo "script/bundle: --profile needs --sign: a profile is for a Developer ID signature" >&2
  exit 2
fi

# The feed is read over HTTPS alone (koyo's updates/feed.rs).
case "$feed" in
  "" | https://?*) ;;
  *) echo "script/bundle: --feed takes the https address of a feed.json, not $feed" >&2; exit 2 ;;
esac

version=$(sed -n 's/^version = "\(.*\)"$/\1/p' koyo-rs/koyo/Cargo.toml | head -1)
out=koyo-rs/target/bundle
app="$out/Koyo.app"
engine="$out/engine"
mkdir -p "$out"

# The profile, read and checked: it names the team, is for this app, and carries the passkey
# entitlement. What the app claims of it is written from it, so the two can't disagree.
granted_by_profile=""
if [ -n "$profile" ]; then
  decoded="$out/profile.plist"
  if ! security cms -D -i "$profile" > "$decoded" 2>/dev/null; then
    echo "script/bundle: $profile is not a provisioning profile" >&2
    exit 1
  fi
  value() { plutil -extract "$1" raw -o - "$decoded" 2>/dev/null || true; }
  team=$(value TeamIdentifier.0)
  app_id=$(value 'Entitlements.com\.apple\.application-identifier')
  granted=$(value "Entitlements.$(printf %s "$PASSKEYS" | sed 's/\./\\./g')")
  if [ -z "$team" ] || [ "$app_id" != "$team.$BUNDLE_ID" ]; then
    echo "script/bundle: the profile is for ${app_id:-no app}, not $team.$BUNDLE_ID" >&2
    exit 1
  fi
  if [ "$granted" != true ]; then
    echo "script/bundle: the profile doesn't carry $PASSKEYS; Apple grants it on request" >&2
    echo "(docs/browser.md 9.4)" >&2
    exit 1
  fi
  granted_by_profile="  <key>com.apple.application-identifier</key>
  <string>$team.$BUNDLE_ID</string>
  <key>com.apple.developer.team-identifier</key>
  <string>$team</string>
  <key>$PASSKEYS</key>
  <true/>"
fi
# What a release identity's signature claims. It signs with the hardened runtime, which
# withholds some things from a process until its signature asks for them. The app asks for
# the camera, the microphone and the location, which pages reach through it and macOS still
# asks the person about, and for what the profile grants. The agent host asks to make memory
# it can run: it's JavaScript compiled as it runs, and without that it ends at its start
# (docs/browser.md 9.4).
entitlements=""
if [ -n "$identity" ]; then
  entitlements="$out/Koyo.entitlements"
  cat > "$entitlements" <<ENTITLEMENTS
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>com.apple.security.device.camera</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.personal-information.location</key>
  <true/>
$granted_by_profile
</dict>
</plist>
ENTITLEMENTS
  plutil -lint -s "$entitlements"
  if ! security find-identity -v -p codesigning | grep -qF "\"$identity\""; then
    echo "script/bundle: no signing identity \"$identity\" in the keychain" >&2
    exit 1
  fi
else
  local_identity=$(script/signing-identity --hash || :)
  if [ -z "$local_identity" ]; then
    echo "script/bundle: signing ad hoc: macOS forgets what Koyo was allowed at every build" \
      "until script/signing-identity has run once (docs/browser.md 12.7)" >&2
  fi
fi
# codesign would wait on a password dialog for as long as nobody answered it, so a build that
# can't sign unasked stops here, and again before signing, the keychain having locked
# meanwhile. Not ad hoc instead, which would lose what Koyo was allowed.
signing_ready() {
  [ -z "${local_identity:-}" ] && return
  script/signing-identity --ready && return
  echo "script/bundle: codesign can't sign with \"Koyo Local Signing\" without a password" \
    "dialog: unlock the login keychain, or run script/signing-identity once at the Mac" >&2
  exit 1
}
signing_ready

# The browser engine first: it's packaged only from the framework script/cef builds from this
# checkout's patches, with H.264 and AAC, and refuses any other before the app's long build
# (script/browser-engine). Packaged afresh, so the one version here is the lockfile's CEF.
rm -rf "$engine"
if [ -n "$identity" ]; then
  script/browser-engine --release --out "$PWD/$engine" --sign "$identity"
else
  script/browser-engine --release --out "$PWD/$engine"
fi
script/cargo build -p koyo --release
# A device's host: a plain executable beside the app's own, holding no grant (docs/devices.md 3).
script/cargo build -p koyo-device-host --release
script/agent-host

rm -rf "$app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources" "$app/Contents/Frameworks"
cp koyo-rs/target/release/koyo "$app/Contents/MacOS/koyo"
cp koyo-js/koyo-agent-host/dist/koyo-agent-host "$app/Contents/MacOS/koyo-agent-host"
cp koyo-rs/target/release/koyo-device-host "$app/Contents/MacOS/koyo-device-host"
cp koyo-rs/koyo/icons/Koyo.icns "$app/Contents/Resources/Koyo.icns"
# The code font is embedded in the binary; its licence has to travel with it.
cp koyo-rs/koyo/fonts/OFL.txt "$app/Contents/Resources/JetBrainsMono-OFL.txt"
# -R keeps the framework's symlinks, which its signature covers; -c clones rather than copies.
cp -cR "$engine"/*/"Koyo Browser Host.app" "$app/Contents/Frameworks/"
# The agent desktop's host: its loader app and, beside it, the library the loader loads, each
# signed by script/desk-host. The loader comes out the same binary from every build, so the
# privacy grants the person gave it hold across builds signed ad hoc (docs/agent-desktop.md 3).
if [ -n "$identity" ]; then
  script/desk-host --release --out "$PWD/$app/Contents/Frameworks" --sign "$identity"
else
  script/desk-host --release --out "$PWD/$app/Contents/Frameworks"
fi
# Koyo opens web pages, and says so: the http and https addresses, which is what makes macOS
# offer it among the web browsers and hand it a link (koyo's links.rs opens it as an unpinned
# page), and what Apple asks of a browser before it grants one its passkeys
# (docs/browser.md 9.4).
#
# What pages in its browser may reach, said why: macOS holds the app that launched the browser
# engine responsible for it, so ends Koyo's engine for using Bluetooth (Google's sign-in looks
# for a phone's passkey), the camera or the microphone unless Koyo's own Info.plist says why.
# The reasons are the engine's own (script/browser-engine), read back so the two can't drift.
host_plist="$app/Contents/Frameworks/Koyo Browser Host.app/Contents/Info.plist"
reason() { plutil -extract "$1" raw -o - "$host_plist"; }
location=$(reason NSLocationUsageDescription)
bluetooth=$(reason NSBluetoothAlwaysUsageDescription)
camera=$(reason NSCameraUsageDescription)
microphone=$(reason NSMicrophoneUsageDescription)
# The oldest macOS Koyo starts on: the newer of what its own executable was built for and
# what its engine says it needs, which is Chromium's (script/browser-engine). Read, not
# written here, so it's true whenever Chromium raises it, and an update isn't offered to a
# Mac it wouldn't start on (docs/updates.md 4).
macos=$({
  vtool -show-build "$app/Contents/MacOS/koyo" | awk '$1 == "minos" { print $2 }'
  reason LSMinimumSystemVersion
} | sort -V | tail -n 1)
cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>Koyo</string>
  <key>CFBundleExecutable</key>
  <string>koyo</string>
  <key>CFBundleIconFile</key>
  <string>Koyo</string>
  <key>CFBundleIdentifier</key>
  <string>$BUNDLE_ID</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>Koyo</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>$version</string>
  <key>CFBundleVersion</key>
  <string>$version</string>
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>Web page</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>http</string>
        <string>https</string>
      </array>
    </dict>
  </array>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.developer-tools</string>
  <key>LSMinimumSystemVersion</key>
  <string>$macos</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSLocationUsageDescription</key>
  <string>$location</string>
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>$location</string>
  <key>NSBluetoothAlwaysUsageDescription</key>
  <string>$bluetooth</string>
  <key>NSCameraUsageDescription</key>
  <string>$camera</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>$microphone</string>
</dict>
</plist>
PLIST
if [ -n "$feed" ]; then
  plutil -insert KoyoUpdateFeed -string "$feed" "$app/Contents/Info.plist"
fi
# The engine is signed already, inside out; this seals the app round it, the agent host first.
if [ -n "$identity" ]; then
  set -- --force --timestamp --options runtime --sign "$identity"
  codesign "$@" --entitlements script/entitlements/allow-jit.plist "$app/Contents/MacOS/koyo-agent-host"
  codesign "$@" "$app/Contents/MacOS/koyo-device-host"
  if [ -n "$profile" ]; then
    cp "$profile" "$app/Contents/embedded.provisionprofile"
  fi
  codesign "$@" --entitlements "$entitlements" "$app"
else
  # The app's own signature is what macOS keeps its grants by: the engine's helpers and the
  # agent host run as Koyo's, so theirs stay ad hoc.
  signing_ready
  codesign --force --timestamp=none --sign "${local_identity:--}" "$app"
fi
codesign --verify --strict "$app"
# What the app claims, said back: what Apple grants a browser only with its profile, since
# macOS won't start an app that claims that without one, and nothing at all without --sign.
claimed=$(codesign -d --entitlements - --xml "$app" 2>/dev/null || true)
if [ -n "$profile" ]; then
  case "$claimed" in
    *"$PASSKEYS"*) echo "Signed for passkeys ($team.$BUNDLE_ID)" ;;
    *) echo "script/bundle: the signature doesn't carry $PASSKEYS" >&2; exit 1 ;;
  esac
elif [ -z "$identity" ] && [ -n "$claimed" ]; then
  echo "script/bundle: the app claims entitlements without --sign:" >&2
  echo "$claimed" >&2
  exit 1
fi
echo "Built $app"
