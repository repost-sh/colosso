#!/bin/sh
# What a running Koyo costs the machine over a window of time: the CPU seconds, context switches
# (a thread woken and put on a core) and BSD system calls of the app and of its other processes,
# and the memory footprint of each at the end. The other processes are those under the app (the
# browser engine) and, for an instance with a data folder of its own such as the verify skill's,
# every process carrying its KOYO_DATA_DIR (the terminal daemon and the agent host, which outlive
# the app). No sudo: it reads `ps` and `top` for processes of your own.
#
#   script/perf-sample <pid> <seconds> <label> [--profile]
#
# Writes .superpowers/perf/<stamp>-<label>.tsv, one row a process and a total row, and prints it.
# --profile also runs `sample` on the app every 10 ms over the window, into <stamp>-<label>.sample.txt,
# to find what wakes its main thread; the profiler stops the app to sample it, so that window's
# numbers go to <stamp>-<label>.profiled.tsv and are not ones to report.
set -eu
cd "$(dirname "$0")/.."

[ $# -ge 3 ] || { echo "usage: script/perf-sample <pid> <seconds> <label> [--profile]" >&2; exit 2; }
pid=$1 seconds=$2 label=$3 profile=${4:-}
kill -0 "$pid" 2>/dev/null || { echo "process $pid doesn't run" >&2; exit 1; }

out=.superpowers/perf
mkdir -p "$out"
base="$out/$(date +%Y%m%d-%H%M%S)-$label"

descend() { echo "$1"; for child in $(pgrep -P "$1"); do descend "$child"; done; }
data=$(ps eww -o command= -p "$pid" | tr ' ' '\n' | sed -n 's/^KOYO_DATA_DIR=//p' | head -1)
tree=$({
  descend "$pid"
  [ -z "$data" ] || ps eww -A -o pid=,command= | grep -F "KOYO_DATA_DIR=$data" | grep -v grep | awk '{ print $1 }'
} | sort -un)

table="$base.tsv"
if [ "$profile" = "--profile" ]; then
  table="$base.profiled.tsv"
  sample "$pid" "$seconds" 10 -mayDie -file "$base.sample.txt" >/dev/null 2>&1 &
fi

args=""
for p in $tree; do args="$args -pid $p"; done

# Two samples a window apart: the counters at the start, then at the end. awk reads "123+" as 123.
# shellcheck disable=SC2086
top -l 2 -s "$seconds" $args -stats pid,time,csw,sysbsd,mem,command 2>/dev/null |
  awk -v label="$label" -v seconds="$seconds" '
    function secs(t,   n, a) { n = split(t, a, ":"); return n == 3 ? a[1] * 3600 + a[2] * 60 + a[3] : a[1] * 60 + a[2] }
    function mib(v,   unit) {
      sub(/[+-]$/, "", v); unit = substr(v, length(v)); v = substr(v, 1, length(v) - 1) + 0
      return unit == "G" ? v * 1024 : unit == "M" ? v : unit == "K" ? v / 1024 : v / 1048576
    }
    BEGIN { OFS = "\t"; print "label", "pid", "command", "cpu_s", "cpu_pct", "csw", "csw_per_s", "syscalls", "footprint_mib" }
    $1 == "PID" { pass++; next }
    $1 !~ /^[0-9]+$/ { next }
    pass == 1 { t0[$1] = secs($2); c0[$1] = $3; s0[$1] = $4 }
    pass == 2 {
      name = $6; for (i = 7; i <= NF; i++) name = name " " $i
      cpu = secs($2) - t0[$1]; csw = $3 - c0[$1]; sys = $4 - s0[$1]; mem = mib($5)
      printf "%s\t%s\t%s\t%.2f\t%.1f\t%d\t%.1f\t%d\t%.1f\n", label, $1, name, cpu, 100 * cpu / seconds, csw, csw / seconds, sys, mem
      n++; tc += cpu; tw += csw; ts += sys; tm += mem
    }
    END { printf "%s\ttotal\t%d processes\t%.2f\t%.1f\t%d\t%.1f\t%d\t%.1f\n", label, n, tc, 100 * tc / seconds, tw, tw / seconds, ts, tm }
  ' > "$table"

wait
column -t -s "$(printf '\t')" "$table"
echo "$table"
