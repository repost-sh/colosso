#!/bin/sh
# Lints the working tree, staged or not, when `git commit` runs; script/check adds the tests.
#
# Git runs a hook with GIT_DIR and GIT_INDEX_FILE set, and with GIT_DIR set a git call made from
# a folder inside the checkout (koyo-hygiene's, from koyo-rs) takes that folder for the checkout's
# root. The lint reads the working tree, so it runs without them.
set -eu
exec env -u GIT_DIR -u GIT_INDEX_FILE "$(git rev-parse --show-toplevel)/script/lint"
