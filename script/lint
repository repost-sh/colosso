#!/bin/sh
# The lint half of script/check, which the pre-commit hook runs on its own: Clippy under the
# workspace lint policy with every warning an error, and the file-size limit.
set -eu
cd "$(dirname "$0")/.."

# The same cargo home as script/dev, so the two share what's built.
export CARGO_HOME="${CARGO_HOME:-$PWD/.cargo-home}"

cargo clippy --workspace --all-targets -- -D warnings
script/hygiene
