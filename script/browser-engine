#!/bin/sh
# Packages the browser engine the app runs its browser panes on: the browser host
# (koyo-rs/koyo-browser-host), the Chromium Embedded Framework and CEF's helper apps, laid out
# as macOS wants them, under koyo-rs/target/browser-engine/<cef version>/ with an engine.json
# beside:
#
#   script/browser-engine [--release] [--out <dir>] [--cef <dir>] [--locales en,de]
#                         [--sign <identity>]
#
# A debug app finds the engine there; a bundled app carries the host app in its own
# Contents/Frameworks (see koyo-rs/koyo/src/browser/engine.rs). script/dev runs this
# before the app, and it does nothing when the packaged host is as new as the built one.
# Without --sign the bundle gets an ad-hoc signature, enough to run locally; a release
# identity gets the hardened runtime notarization needs.
set -eu
cd "$(dirname "$0")/.."

HOST_NAME="Koyo Browser Host"
BUNDLE_ID="dev.koyo.desktop.browser-host"
FRAMEWORK="Chromium Embedded Framework.framework"
# The app's icon, which macOS shows for the host and its helpers when one asks for
# something, as for notifications.
ICON=koyo-rs/koyo/icons/Koyo.icns
# Why the host would know where the computer is, which macOS shows when it asks the person.
LOCATION_REASON="Pages open in Koyo can then ask to know where you are. Each one asks you first."
# Why it would use Bluetooth, the camera and the microphone. macOS ends an app that reaches one
# without saying why in its Info.plist: Google's sign-in page alone looks for a phone's passkey
# over Bluetooth. macOS holds the app that launched the host responsible, so Koyo.app says the
# same (script/bundle); these count when the host is its own.
BLUETOOTH_REASON="Pages open in Koyo can then sign you in with a passkey on your phone or a security key, or reach a Bluetooth device. Each one asks you first."
CAMERA_REASON="Pages open in Koyo can then use your camera, as a video call does. Each one asks you first."
MICROPHONE_REASON="Pages open in Koyo can then use your microphone, as a video call does. Each one asks you first."
# The protocol the host speaks, read from where it's defined so the two can't drift.
IPC_PROTOCOL=$(sed -n 's/^pub const PROTOCOL: u32 = \([0-9][0-9]*\);$/\1/p' \
  koyo-rs/koyo-browser-ipc/src/lib.rs)
if [ -z "$IPC_PROTOCOL" ]; then
  echo "script/browser-engine: no PROTOCOL in koyo-rs/koyo-browser-ipc/src/lib.rs" >&2
  exit 1
fi

profile=debug
cargo_profile=dev
# The workspace's KOYO_TARGET_DIR (koyo-rs/.cargo/config.toml), where a debug app looks.
out="koyo-rs/target/browser-engine"
cef=""
locales=""
sign=""
while [ $# -gt 0 ]; do
  case "$1" in
    --release) profile=release; cargo_profile=release ;;
    --out) out="$2"; shift ;;
    --cef) cef="$2"; shift ;;
    --locales) locales="$2"; shift ;;
    --sign) sign="$2"; shift ;;
    *) echo "unknown option $1" >&2; exit 2 ;;
  esac
  shift
done

# The CEF version is the lockfile's: the `+` part of cef-dll-sys's version.
version=$(awk '/^name = "cef-dll-sys"$/ { getline; sub(/^version = "[^+]*\+/, ""); sub(/"$/, ""); print }' koyo-rs/Cargo.lock)
if [ -z "$version" ]; then
  echo "cef-dll-sys is not in koyo-rs/Cargo.lock" >&2
  exit 1
fi
case "$(uname -m)" in
  arm64) arch=aarch64 ;;
  *) arch=x86_64 ;;
esac
target="$arch-apple-darwin"
# Where cef-dll-sys keeps the distribution: koyo-rs/.cargo/config.toml's CEF_PATH, the same
# folder from the checkout's root.
cef="${cef:-${CEF_PATH:-.superpowers/cef}/$version/cef_macos_$arch}"

script/cargo build -p koyo-browser-host --profile "$cargo_profile"
binary="koyo-rs/target/$profile/koyo-browser-host"

dir="$out/$version"
app="$dir/$HOST_NAME.app/Contents"
packaged="$app/MacOS/$HOST_NAME"
# Packaged again once the host, its icon, this script or the CEF distribution (script/cef
# puts a framework built with H.264 and AAC in it) is newer than the package.
if [ -f "$packaged" ] && [ -f "$dir/engine.json" ] && ! [ "$binary" -nt "$packaged" ] &&
  ! [ "$ICON" -nt "$packaged" ] && ! [ "$0" -nt "$packaged" ] &&
  ! [ "$cef/archive.json" -nt "$packaged" ]; then
  echo "Browser engine $version is packaged in $dir"
  exit 0
fi
if [ ! -d "$cef/$FRAMEWORK" ]; then
  echo "no CEF distribution at $cef: build koyo-rs/koyo-browser-host first" >&2
  exit 1
fi

# The host's Info.plist, and the helpers': background-only agents, no dock icon or menu bar
# for any of them, the app composing the panes. An ad-hoc build keeps cookies under a fixed
# key rather than asking for Keychain access after every rebuild; the signature seals this.
# The host says why it would know where the computer is: macOS asks the person only with a
# reason, and tells a page where it is only once it has asked (koyo-browser-host's
# location.rs).
plist() { # executable identifier helper(yes|no)
  cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>$1</string>
  <key>CFBundleExecutable</key>
  <string>$1</string>
  <key>CFBundleIconFile</key>
  <string>Koyo</string>
  <key>CFBundleIdentifier</key>
  <string>$2</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>$1</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>$version</string>
  <key>CFBundleVersion</key>
  <string>$version</string>
  <key>LSMinimumSystemVersion</key>
  <string>12.0</string>
  <key>LSUIElement</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
PLIST
  if [ "$3" = no ]; then
    cat <<PLIST
  <key>LSEnvironment</key>
  <dict>
    <key>MallocNanoZone</key>
    <string>0</string>
  </dict>
  <key>NSLocationUsageDescription</key>
  <string>$LOCATION_REASON</string>
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>$LOCATION_REASON</string>
  <key>NSBluetoothAlwaysUsageDescription</key>
  <string>$BLUETOOTH_REASON</string>
  <key>NSCameraUsageDescription</key>
  <string>$CAMERA_REASON</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>$MICROPHONE_REASON</string>
PLIST
    if [ -z "$sign" ]; then
      cat <<PLIST
  <key>KoyoMockKeychain</key>
  <true/>
PLIST
    fi
  fi
  cat <<PLIST
</dict>
</plist>
PLIST
}

rm -rf "$dir"
frameworks="$app/Frameworks"
mkdir -p "$app/MacOS" "$app/Resources" "$frameworks"
cp "$binary" "$packaged"
cp "$ICON" "$app/Resources/Koyo.icns"
plist "$HOST_NAME" "$BUNDLE_ID" no > "$app/Info.plist"
# -R keeps the framework's symlinks as they are.
cp -R "$cef/$FRAMEWORK" "$frameworks/$FRAMEWORK"
if [ -n "$locales" ]; then
  keep=",$(echo "$locales" | tr 'A-Z' 'a-z'),"
  for lproj in "$frameworks/$FRAMEWORK/Resources/"*.lproj; do
    name=$(basename "$lproj" .lproj | tr 'A-Z' 'a-z')
    language=${name%%[_-]*}
    case "$keep" in
      *",$name,"*|*",$language,"*) ;;
      *) rm -rf "$lproj" ;;
    esac
  done
fi

# Every helper is the same binary; CEF tells it its role with --type and finds each beside
# its framework, by name.
for suffix in "" " (GPU)" " (Renderer)" " (Plugin)" " (Alerts)"; do
  name="$HOST_NAME Helper$suffix"
  contents="$frameworks/$name.app/Contents"
  mkdir -p "$contents/MacOS" "$contents/Resources"
  cp "$binary" "$contents/MacOS/$name"
  cp "$ICON" "$contents/Resources/Koyo.icns"
  chmod 755 "$contents/MacOS/$name"
  role=$(echo "$suffix" | tr -cd 'A-Za-z' | tr 'A-Z' 'a-z')
  plist "$name" "$BUNDLE_ID.helper${role:+.$role}" yes > "$contents/Info.plist"
done

# Inside out: framework, helpers, then the host.
if [ -n "$sign" ]; then
  set -- --force --timestamp --options runtime --sign "$sign"
else
  set -- --force --timestamp=none --sign -
fi
codesign "$@" "$frameworks/$FRAMEWORK"
for suffix in "" " (GPU)" " (Renderer)" " (Plugin)" " (Alerts)"; do
  codesign "$@" "$frameworks/$HOST_NAME Helper$suffix.app"
done
codesign "$@" "$dir/$HOST_NAME.app"

cat > "$dir/engine.json" <<JSON
{
  "version": "$version",
  "cef": "$version",
  "ipc": $IPC_PROTOCOL,
  "target": "$target",
  "host": "$HOST_NAME.app/Contents/MacOS/$HOST_NAME"
}
JSON
echo "Browser engine $version packaged in $dir"
